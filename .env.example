# --- Client (Vite) ---
# Set to "1" to make the app talk to /api/state (Vercel Postgres) instead of
# localStorage. Vercel deployments should set this to 1 in the project's
# Environment Variables. Leave unset for local dev with no DB.
VITE_USE_REMOTE=1

# --- Server (Vercel serverless) ---
# Vercel injects these automatically once you attach a Neon Postgres store
# from Storage -> Marketplace. You should never need to set them manually in
# production. For local `vercel dev`, run `vercel env pull .env.development.local`.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# --- Auth ---
# Shared commissioner key. When set, every mutating /api/* endpoint
# (events, players, overrides, predictions, admin/*) requires the same value
# in the X-Admin-Key request header. Leave BLANK to disable the guard
# entirely (open API) - fine for private dev, do NOT do this in production.
ADMIN_KEY=survive

# --- Legacy / migration only ---
# Only needed if you had data in the old Upstash Redis backend and want to
# run POST /api/admin/migrate-from-kv once. Otherwise leave blank.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
