# --- Client (Vite) ---
# Set to "1" to make the app talk to /api/league instead of localStorage.
# Vercel deployments should set this to 1 in the project's Environment Variables.
VITE_USE_REMOTE=1

# --- Server (Vercel serverless) ---
# These are AUTOMATICALLY injected by Vercel once you attach an Upstash
# Redis (or the legacy Vercel KV) store from Storage -> Marketplace. You
# should never need to set them manually in production. The api reads
# whichever pair is present.
#
# For local `vercel dev`, run `vercel env pull .env.development.local`.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
